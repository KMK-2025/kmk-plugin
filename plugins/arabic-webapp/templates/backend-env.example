# انسخ هذه القيم إلى backend/.env بعد إنشاء المشروع
# (عدّل اسم القاعدة والمستخدم وكلمة السر حسب MySQL عندك)

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_test
