{
  "permissions": {
    "deny": [
      "Read(./backend/.env)",
      "Read(./frontend/.env*)",
      "Edit(./backend/.env)",
      "Edit(./frontend/.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan db:wipe*)",
      "Edit(./frontend/src/shared/api/client.ts)",
      "Edit(./backend/bootstrap/app.php)",
      "Edit(./backend/app/Support/**)"
    ],
    "allow": [
      "Bash(npm run*)",
      "Bash(npm install*)",
      "Bash(npx tsc*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate --force)",
      "Bash(php artisan test*)",
      "Bash(php artisan serve*)",
      "Bash(php artisan db:seed*)",
      "Bash(composer require*)",
      "Bash(composer install*)",
      "Bash(./vendor/bin/pint*)",
      "Bash(./vendor/bin/phpstan*)",
      "Bash(./vendor/bin/pest*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx vitest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(docker compose*)",
      "Bash(docker*)",
      "Bash(cloudflared*)",
      "Bash(npm ci*)",
      "Bash(npm run check*)",
      "Bash(npm run build*)",
      "Bash(git tag*)",
      "Bash(git rm -r --force*)",
      "Bash(git for-each-ref*)",
      "Bash(git push origin work*)",
      "Bash(gh repo create*)",
      "Bash(gh run*)",
      "Bash(php artisan lang:publish*)",
      "Bash(php artisan tinker*)",
      "Bash(mysql*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/autosave.sh\""
          }
        ]
      }
    ]
  }
}
