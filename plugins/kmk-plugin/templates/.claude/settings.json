{
  "permissions": {
    "deny": [
      "Read(./backend/.env)",
      "Read(./frontend/.env*)",
      "Edit(./backend/.env)",
      "Edit(./frontend/.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan db:wipe*)"
    ],
    "allow": [
      "Bash(npm run*)",
      "Bash(npm install*)",
      "Bash(npx tsc*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate --force)",
      "Bash(php artisan test*)",
      "Bash(php artisan serve*)",
      "Bash(php artisan db:seed*)",
      "Bash(composer require*)",
      "Bash(composer install*)",
      "Bash(./vendor/bin/pint*)",
      "Bash(./vendor/bin/phpstan*)",
      "Bash(./vendor/bin/pest*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx vitest*)",
      "Bash(bash .claude/scripts/bump-api-version.sh*)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(adb *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(docker compose*)",
      "Bash(docker*)",
      "Bash(cloudflared*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/autosave.sh\""
          }
        ]
      }
    ]
  }
}